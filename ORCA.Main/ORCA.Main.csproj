<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ORCA.Main</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.19" />
    <PackageReference Include="ZoneTree" Version="1.9.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NSA.Network.Core\NSA.Network.Core.csproj" />
    <ProjectReference Include="..\NSA.Security.Core\NSA.Security.Core.csproj" />
  </ItemGroup>

</Project>
